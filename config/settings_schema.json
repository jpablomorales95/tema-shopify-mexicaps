  {
    "name": "DRIFT \u2014 Cart",
    "settings": [
      {
        "type": "paragraph",
        "content": "DRIFT uses a custom cart drawer that opens automatically when a product is added to cart."
      },
      {
        "type": "checkbox",
        "id": "cart_show_dynamic_buttons",
        "label": "Show dynamic checkout buttons",
        "info": "Displays accelerated checkout buttons (Apple Pay, Shop Pay, Google Pay, etc.) below the Checkout button. Which buttons appear depends on your Shopify Payments settings.",
        "default": true
      },
      {
        "type": "header",
        "content": "Free Shipping Bar"
      },
      {
        "type": "checkbox",
        "id": "cart_free_shipping_enabled",
        "label": "Enable free shipping progress bar",
        "info": "Shows a progress bar in the cart drawer indicating how close the customer is to free shipping.",
        "default": false
      },
      {
        "type": "number",
        "id": "cart_free_shipping_threshold",
        "label": "Free shipping threshold",
        "info": "Amount in your store's base currency (e.g. 100 = $100). The progress bar compares against the cart subtotal.",
        "default": 100
      },
      {
        "type": "header",
        "content": "Cart Upsell"
      },
      {
        "type": "checkbox",
        "id": "cart_upsell_enabled",
        "label": "Enable cart upsell",
        "info": "Displays a collapsible row of recommended products above the checkout button. Recommendations are powered by Shopify and based on items in the cart. Products already in the cart are excluded. Products with variants link to the product page \u2014 single-variant products can be added directly.",
        "default": false
      },
      {
        "type": "text",
        "id": "cart_upsell_heading",
        "label": "Upsell heading",
        "default": "You may also like",
        "info": "Heading shown above the recommended products. Customers tap to expand or collapse the section."
      },
      {
        "type": "checkbox",
        "id": "cart_upsell_expanded_desktop",
        "label": "Expanded by default \u2014 desktop",
        "default": false,
        "info": "When enabled on desktop, the upsell section is open when the cart drawer opens. Otherwise customers tap the heading to expand it. Mobile is always collapsed by default."
      },
      {
        "type": "range",
        "id": "cart_upsell_limit",
        "label": "Products to show",
        "min": 2,
        "max": 8,
        "step": 1,
        "default": 4,
        "info": "Maximum number of recommended products. Products already in the cart are automatically excluded."
      }
    ]
  }
]