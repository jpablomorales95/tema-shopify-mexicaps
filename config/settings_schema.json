  {
    "name": "DRIFT \u2014 General",
    "settings": [
      {
        "type": "header",
        "content": "Color Mode"
      },
      {
        "type": "select",
        "id": "drift_default_mode",
        "label": "Default color mode",
        "info": "The color mode the site loads in. Shoppers can toggle between light and dark using the header switch.",
        "options": [
          {
            "value": "light",
            "label": "Light"
          },
          {
            "value": "dark",
            "label": "Dark"
          }
        ],
        "default": "dark"
      },
      {
        "type": "paragraph",
        "content": "DRIFT uses its own light/dark mode system \u2014 the color schemes below are required by Shopify but do not affect this theme's appearance."
      },
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#FFFFFF"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "Background gradient"
          },
          {
            "type": "color",
            "id": "text",
            "label": "Text",
            "default": "#121212"
          },
          {
            "type": "color",
            "id": "button",
            "label": "Button background",
            "default": "#121212"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "Button label",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "Secondary button label",
            "default": "#121212"
          },
          {
            "type": "color",
            "id": "shadow",
            "label": "Shadow",
            "default": "#121212"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "secondary_button_label",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "secondary_button_label"
        }
      }
    ]
  },
  {
    "name": "DRIFT \u2014 Background",
    "settings": [
      {
        "type": "paragraph",
        "content": "V3 feature: Replace the solid color background with an image or video. When disabled, DRIFT uses solid backgrounds (light: #FAFAFA, dark: #0A0A0A)."
      },
      {
        "type": "checkbox",
        "id": "drift_bg_enabled",
        "label": "Enable image/video background",
        "default": false
      },
      {
        "type": "header",
        "content": "Media"
      },
      {
        "type": "image_picker",
        "id": "drift_bg_image",
        "label": "Background image",
        "info": "Used for both modes. If a dark mode image is also uploaded, this becomes the light mode image."
      },
      {
        "type": "image_picker",
        "id": "drift_bg_image_dark",
        "label": "Dark mode image (optional)",
        "info": "Overrides the background image when the site is in dark mode. Leave empty to use one image for both modes."
      },
      {
        "type": "text",
        "id": "drift_bg_video",
        "label": "Video URL",
        "info": "Direct link to an MP4 file. Upload to Shopify Files and paste the URL here. Autoplays muted and loops. Images display on top of video when both are set."
      },
      {
        "type": "header",
        "content": "Adjustments"
      },
      {
        "type": "range",
        "id": "drift_bg_blur",
        "label": "Background blur",
        "info": "Blurs the background media so site content stays the focus.",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 0,
        "unit": "px"
      },
      {
        "type": "checkbox",
        "id": "drift_bg_invert",
        "label": "Invert media in dark mode",
        "default": false,
        "info": "Inverts the colors of the background image/video when the site is in dark mode. Lets you use one image for both modes without uploading a separate dark version. Works best with graphics, patterns, and illustrations."
      },
      {
        "type": "header",
        "content": "Overlay"
      },
      {
        "type": "checkbox",
        "id": "drift_bg_auto_overlay",
        "label": "Auto overlay",
        "default": true,
        "info": "Adds a mode-aware color overlay for better text readability. Light mode gets a light overlay, dark mode gets a dark overlay."
      },
      {
        "type": "range",
        "id": "drift_bg_overlay_opacity",
        "label": "Overlay opacity",
        "info": "How strong the overlay is. Higher values = more of the background is hidden.",
        "min": 0,
        "max": 100,
        "step": 5,
        "default": 10,
        "unit": "%"
      }
    ]
  },
