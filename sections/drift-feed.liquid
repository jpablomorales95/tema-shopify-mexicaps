{% comment %}
  ============================================
  DRIFT Theme by WEBEXP, LLC
  DRIFT Feed — Vertical Swipe
  V3: Quick-Add
  https://webexp.dev
  ============================================
{% endcomment %}

{%- liquid
  assign feed_collection = section.settings.collection | default: collections.frontpage
  assign products = feed_collection.products
  assign limit = section.settings.products_per_page | default: 20
  assign image_ratio = section.settings.image_ratio | default: '1-1'
  assign default_view = section.settings.default_view | default: 'swipe'
  assign allow_toggle = section.settings.allow_toggle
  if allow_toggle == nil
    assign allow_toggle = true
  endif
  assign grid_columns = section.settings.grid_columns_desktop | default: 4
  assign show_title = section.settings.show_title
  assign show_price = section.settings.show_price
  assign hover_effect = section.settings.hover_effect | default: 'grow'
  assign indicator = section.settings.indicator_type
  assign enable_quick_add = section.settings.enable_quick_add
  assign total = products.size
  if total > limit
    assign total = limit
  endif
-%}

{%- if products.size > 0 -%}
  <div
    class="drift-feed-section"
    data-section-id="{{ section.id }}"
    data-section-type="drift-feed"
    data-default-view="{{ default_view }}"
    data-allow-toggle="{{ allow_toggle }}"
    data-view-mode="{{ default_view }}"
  >
    {%- comment -%} ============================================
       SWIPE VIEW — original .drift-feed swipe takeover
       ============================================ {%- endcomment -%}
  <div
    class="drift-feed"
    data-feed-view="swipe"
    data-feed-total="{{ total }}"
    data-feed-hover="{{ hover_effect }}"
    aria-label="Product feed — swipe or scroll to browse"
    {% if default_view == 'grid' %}hidden{% endif %}
  >
    <div class="drift-feed__track" data-feed-track data-feed-ratio="{{ image_ratio }}">

      <span class="drift-feed__spacer drift-feed__spacer--top" data-feed-spacer="top" aria-hidden="true"></span>

      {%- for product in products limit: limit -%}
        {%- assign featured_image = product.featured_image -%}
        {%- assign is_sold_out = false -%}
        {%- unless product.available -%}
          {%- assign is_sold_out = true -%}
        {%- endunless -%}
        {%- comment -%} Pre-order metafield (FEATURE) {%- endcomment -%}
        {%- assign product_is_preorder = product.metafields.custom.is_preorder -%}
        {%- assign product_preorder_text = product.metafields.custom.preorder_text -%}
        {%- if product_preorder_text == blank -%}
          {%- assign product_preorder_text = 'Pre-Order' -%}
        {%- endif -%}
        {%- assign show_quick_add = false -%}
        {%- if enable_quick_add -%}
          {%- if product.available or product_is_preorder -%}
            {%- assign show_quick_add = true -%}
          {%- endif -%}
        {%- endif -%}
        <a
          href="{{ product.url }}?from=drift&feed_index={{ forloop.index0 }}"
          class="drift-feed__slide{% if is_sold_out %} is-sold-out{% endif %}"
          data-feed-slide="{{ forloop.index0 }}"
          aria-label="{{ product.title | escape }}{% if is_sold_out %} — sold out{% endif %}"
        >
          {% render 'drift-badge', product: product %}
          <span class="drift-feed__media">
            {% render 'mxcs-exclusive-badge', product: product %}
            {%- if featured_image != blank -%}
              <img
                src="{{ featured_image | image_url: width: 1200 }}"
                srcset="
                  {{ featured_image | image_url: width: 600 }} 600w,
                  {{ featured_image | image_url: width: 900 }} 900w,
                  {{ featured_image | image_url: width: 1200 }} 1200w,
                  {{ featured_image | image_url: width: 1800 }} 1800w
                "
                sizes="100vw"
                alt="{{ featured_image.alt | default: product.title | escape }}"
                width="{{ featured_image.width }}"
                height="{{ featured_image.height }}"
                class="drift-feed__image"
                {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                draggable="false"
              >
              {%- comment -%} Image-swap hover effect: 2nd image fades in on hover {%- endcomment -%}
              {%- if hover_effect == 'image-swap' and product.available and product.images.size > 1 -%}
                {%- assign hover_image = product.images[1] -%}
                <img
                  src="{{ hover_image | image_url: width: 1200 }}"
                  srcset="
                    {{ hover_image | image_url: width: 600 }} 600w,
                    {{ hover_image | image_url: width: 900 }} 900w,
                    {{ hover_image | image_url: width: 1200 }} 1200w,
                    {{ hover_image | image_url: width: 1800 }} 1800w
                  "
                  sizes="100vw"
                  alt=""
                  width="{{ hover_image.width }}"
                  height="{{ hover_image.height }}"
                  class="drift-feed__image drift-feed__image--hover"
                  loading="lazy"
                  draggable="false"
                  aria-hidden="true"
                >
              {%- endif -%}
            {%- else -%}
              <span class="drift-feed__placeholder">
                {{ product.title | escape }}
              </span>
            {%- endif -%}
          </span>

          {%- if show_title or show_price or enable_quick_add -%}
            <span class="drift-feed__info" data-feed-info>
              {%- if show_title -%}
                <span class="drift-feed__title" data-feed-title>{{ product.title | escape }}</span>
              {%- endif -%}
              {%- if show_price -%}
                <span class="drift-feed__price" data-feed-price>
                  {%- if is_sold_out -%}
                    <span class="drift-feed__price-sold-out">{{ 'products.product.sold_out' | t }}</span>
                  {%- else -%}
                    {%- if product.compare_at_price > product.price -%}
                      {%- assign compare_mod = product.compare_at_price | modulo: 100 -%}
                      <span class="drift-feed__price-compare" data-compare-price="{{ product.compare_at_price }}">
                        {%- if compare_mod == 0 -%}
                          {{ product.compare_at_price | money_without_trailing_zeros }}
                        {%- else -%}
                          {{ product.compare_at_price | money }}
                        {%- endif -%}
                      </span>
                    {%- endif -%}
                    {%- assign price_mod = product.price | modulo: 100 -%}
                    <span class="drift-feed__price-current{% if product.compare_at_price > product.price %} drift-feed__price-current--sale{% endif %}" data-product-price="{{ product.price }}">
                      {%- if price_mod == 0 -%}
                        {{ product.price | money_without_trailing_zeros }}
                      {%- else -%}
                        {{ product.price | money }}
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                </span>
              {%- endif -%}
              {%- if show_quick_add -%}
                <button
                  class="drift-feed__quick-add-btn"
                  data-quick-add-trigger
                  data-product-url="{{ product.url }}.js"
                  data-product-id="{{ product.id }}"
                  data-preorder="{% if product_is_preorder %}true{% else %}false{% endif %}"
                  data-preorder-text="{{ product_preorder_text | escape }}"
                  type="button"
                  aria-label="Quick add {{ product.title | escape }}"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
                {% render 'drift-quick-add-prices', product: product %}
              {%- endif -%}
            </span>
          {%- endif -%}
        </a>
      {%- endfor -%}

      <span class="drift-feed__spacer drift-feed__spacer--bottom" data-feed-spacer="bottom" aria-hidden="true"></span>

    </div>

    {%- if indicator == 'dots' -%}
      <span class="drift-feed__indicator drift-feed__indicator--dots" data-feed-indicator="dots" aria-hidden="true">
        {%- for product in products limit: limit -%}
          <button
            class="drift-feed__dot{% if forloop.first %} is-active{% endif %}"
            data-feed-dot="{{ forloop.index0 }}"
            type="button"
            aria-label="Go to product {{ forloop.index }}"
          ></button>
        {%- endfor -%}
      </span>
    {%- endif -%}

    {%- if indicator == 'numbers' -%}
      <span class="drift-feed__indicator drift-feed__indicator--numbers drift-glass drift-glass--subtle" data-feed-indicator="numbers">
        <span data-feed-current>{% if total >= 10 %}01{% else %}1{% endif %}</span>
        <span class="drift-feed__counter-sep"></span>
        <span data-feed-total>{% if total >= 10 %}{{ total | prepend: '00' | slice: -2, 2 }}{% else %}{{ total }}{% endif %}</span>
      </span>
    {%- endif -%}

  </div>

    {%- comment -%} ============================================
       GRID VIEW — mirrors drift-collection's grid (same classes,
       same CSS, same look). Hidden when default_view == 'swipe'.
       ============================================ {%- endcomment -%}
    <div
      class="drift-collection__grid-wrap"
      data-feed-view="grid"
      data-grid-ratio="{{ image_ratio }}"
      data-grid-hover="{{ hover_effect }}"
      {% if default_view == 'swipe' %}hidden{% endif %}
    >
      <div class="drift-collection__grid drift-collection__grid--{{ grid_columns }}-col">
        {%- for product in products limit: limit -%}
          {%- assign featured_image = product.featured_image -%}
          {%- assign is_sold_out = false -%}
          {%- unless product.available -%}
            {%- assign is_sold_out = true -%}
          {%- endunless -%}
          {%- assign product_is_preorder = product.metafields.custom.is_preorder -%}
          {%- assign product_preorder_text = product.metafields.custom.preorder_text -%}
          {%- if product_preorder_text == blank -%}
            {%- assign product_preorder_text = 'Pre-Order' -%}
          {%- endif -%}
          <span class="drift-collection__grid-item{% if is_sold_out %} is-sold-out{% endif %}">
            <a
              href="{{ product.url }}"
              class="drift-collection__grid-link"
              aria-label="{{ product.title | escape }}{% if is_sold_out %} — sold out{% endif %}"
            >
              <span class="drift-collection__grid-img-wrap">
                {% render 'drift-badge', product: product %}
                {% render 'mxcs-exclusive-badge', product: product %}
                {%- if featured_image != blank -%}
                  <img
                    src="{{ featured_image | image_url: width: 200 }}"
                    data-src="{{ featured_image | image_url: width: 800 }}"
                    data-srcset="
                      {{ featured_image | image_url: width: 400 }} 400w,
                      {{ featured_image | image_url: width: 600 }} 600w,
                      {{ featured_image | image_url: width: 800 }} 800w
                    "
                    sizes="(min-width: 1024px) 25vw, 50vw"
                    alt="{{ featured_image.alt | default: product.title | escape }}"
                    width="{{ featured_image.width }}"
                    height="{{ featured_image.height }}"
                    class="drift-collection__grid-img"
                    loading="eager"
                    draggable="false"
                  >
                  {%- if hover_effect == 'image-swap' and product.available and product.images.size > 1 -%}
                    {%- assign hover_image = product.images[1] -%}
                    <img
                      src="{{ hover_image | image_url: width: 400 }}"
                      data-src="{{ hover_image | image_url: width: 800 }}"
                      data-srcset="
                        {{ hover_image | image_url: width: 400 }} 400w,
                        {{ hover_image | image_url: width: 600 }} 600w,
                        {{ hover_image | image_url: width: 800 }} 800w
                      "
                      sizes="(min-width: 1024px) 25vw, 50vw"
                      alt=""
                      width="{{ hover_image.width }}"
                      height="{{ hover_image.height }}"
                      class="drift-collection__grid-img drift-collection__grid-img--hover"
                      loading="lazy"
                      draggable="false"
                      aria-hidden="true"
                    >
                  {%- endif -%}
                {%- else -%}
                  <span class="drift-collection__grid-placeholder">
                    {{ product.title | truncate: 20 }}
                  </span>
                {%- endif -%}

                {%- if enable_quick_add and product.available -%}
                  <button
                    class="drift-collection__quick-add-btn"
                    data-quick-add-trigger
                    data-product-url="{{ product.url }}.js"
                    data-product-id="{{ product.id }}"
                    data-preorder="{% if product_is_preorder %}true{% else %}false{% endif %}"
                    data-preorder-text="{{ product_preorder_text | escape }}"
                    type="button"
                    aria-label="Quick add {{ product.title | escape }}"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  </button>
                  {% render 'drift-quick-add-prices', product: product %}
                {%- endif -%}
              </span>

              {%- if show_title or show_price -%}
                <span class="drift-collection__grid-info">
                  {%- if show_title -%}
                    <span class="drift-collection__grid-product-title">{{ product.title | escape }}</span>
                  {%- endif -%}
                  {%- if show_price -%}
                    <span class="drift-collection__grid-price">
                      {%- if is_sold_out -%}
                        <span class="drift-collection__grid-price-sold-out">{{ 'products.product.sold_out' | t }}</span>
                      {%- else -%}
                        {%- if product.compare_at_price > product.price -%}
                          {%- assign compare_mod = product.compare_at_price | modulo: 100 -%}
                          <span class="drift-collection__grid-price-compare">
                            {%- if compare_mod == 0 -%}
                              {{ product.compare_at_price | money_without_trailing_zeros }}
                            {%- else -%}
                              {{ product.compare_at_price | money }}
                            {%- endif -%}
                          </span>
                        {%- endif -%}
                        {%- assign price_mod = product.price | modulo: 100 -%}
                        <span class="drift-collection__grid-price-current{% if product.compare_at_price > product.price %} drift-collection__grid-price-current--sale{% endif %}">
                          {%- if price_mod == 0 -%}
                            {{ product.price | money_without_trailing_zeros }}
                          {%- else -%}
                            {{ product.price | money }}
                          {%- endif -%}
                        </span>
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                </span>
              {%- endif -%}
            </a>
          </span>
        {%- endfor -%}
      </div>
    </div>

  </div>
{%- else -%}
  <div class="drift-feed drift-feed--empty">
    <span class="drift-container">
      <p class="drift-muted" style="text-align: center; padding: var(--drift-space-8) 0;">
        No products found in this collection.
      </p>
    </span>
  </div>
{%- endif -%}

{%- if enable_quick_add -%}
  {% render 'drift-quick-add' %}
{%- endif -%}

<script src="{{ 'drift-feed.js' | asset_url }}" defer></script>
{%- if enable_quick_add -%}
  <script src="{{ 'drift-quick-add.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "DRIFT Product Feed",
  "tag": "section",
  "class": "drift-feed-section",
  "disabled_on": {
    "groups": ["header", "footer"],
    "templates": ["password"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Choose which collection to display in the feed. Defaults to your Frontpage collection."
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1-1", "label": "1:1 (Square)" },
        { "value": "3-4", "label": "3:4 (Portrait)" }
      ],
      "default": "1-1",
      "info": "Controls how product images are displayed in the feed."
    },
    {
      "type": "select",
      "id": "default_view",
      "label": "Default view",
      "options": [
        { "value": "swipe", "label": "Swipe" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "swipe",
      "info": "Which layout the feed loads in. Shoppers can switch between the two if 'Allow view toggle' is on."
    },
    {
      "type": "checkbox",
      "id": "allow_toggle",
      "label": "Allow view toggle",
      "default": true,
      "info": "Show a swipe/grid toggle icon in the header so visitors can switch between layouts on the fly."
    },
    {
      "type": "select",
      "id": "grid_columns_desktop",
      "label": "Grid columns (desktop)",
      "options": [
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "4",
      "info": "Mobile is always 2 columns. Used when the feed is in Grid view."
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products to show",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 20,
      "info": "Maximum number of products in the feed."
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show product title",
      "default": false,
      "info": "Display product title below each image."
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show product price",
      "default": false,
      "info": "Display product price below each image."
    },
    {
      "type": "select",
      "id": "hover_effect",
      "label": "Hover effect",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "grow", "label": "Grow" },
        { "value": "glow", "label": "Glow" },
        { "value": "image-swap", "label": "Image swap" }
      ],
      "default": "grow",
      "info": "Grow scales up subtly. Glow adds a soft outline. Image swap fades to the product's 2nd image (requires a 2nd image on the product). Desktop only."
    },
    {
      "type": "select",
      "id": "indicator_type",
      "label": "Progress indicator",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "dots", "label": "Dots" },
        { "value": "numbers", "label": "Numbers" }
      ],
      "default": "numbers",
      "info": "Show a progress indicator on the left side of the feed."
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "label": "Enable quick add",
      "default": false,
      "info": "Shows a quick-add button below each product in the feed. Customers can select variants and add to cart without leaving the page."
    }
  ],
  "presets": [
    {
      "name": "DRIFT Product Feed"
    }
  ]
}
{% endschema %}