{% comment %}
  ============================================
  DRIFT Theme by WEBEXP, LLC
  DRIFT Password Page
  https://webexp.dev
  ============================================
{% endcomment %}

{%- liquid
  assign color_mode = section.settings.color_mode | default: 'dark'
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign show_newsletter = section.settings.show_newsletter
  assign newsletter_heading = section.settings.newsletter_heading
  assign newsletter_subtext = section.settings.newsletter_subtext
  assign logo = section.settings.logo
  assign logo_dark = section.settings.logo_dark
  assign logo_height = section.settings.logo_height
  assign logo_height_2x = logo_height | times: 2
  assign layout_style = section.settings.layout_style | default: 'spread'

  assign countdown_block = nil
  assign bg_block = nil
  for block in section.blocks
    if block.type == 'countdown'
      assign countdown_block = block
    elsif block.type == 'background'
      assign bg_block = block
    endif
  endfor
-%}

<div class="drift-password drift-password--{{ layout_style }}" data-drift-mode="{{ color_mode }}">

  {%- comment -%} ── Background ── {%- endcomment -%}
  {%- if bg_block -%}
    {%- liquid
      assign bg_show_video = bg_block.settings.show_video
      assign bg_video_url = bg_block.settings.video_url
      assign bg_show_image = bg_block.settings.show_image
      assign bg_image = bg_block.settings.image
      assign bg_blur = bg_block.settings.bg_blur | default: 0
      assign bg_brightness = bg_block.settings.bg_brightness | default: 100
      assign bg_hue = bg_block.settings.bg_hue | default: 0
      assign bg_grayscale = bg_block.settings.bg_grayscale | default: 0
      assign bg_sepia = bg_block.settings.bg_sepia | default: 0
      assign bg_invert = bg_block.settings.bg_invert | default: 0
      assign bg_overlay = bg_block.settings.bg_overlay | default: 0

      assign has_filters = false
      if bg_blur != 0 or bg_brightness != 100 or bg_hue != 0 or bg_grayscale != 0 or bg_sepia != 0 or bg_invert != 0
        assign has_filters = true
      endif
    -%}

    <span
      class="drift-password__bg"
      {% if has_filters %}
        style="--pw-bg-blur: {{ bg_blur }}px; --pw-bg-brightness: {{ bg_brightness }}%; --pw-bg-hue: {{ bg_hue }}deg; --pw-bg-grayscale: {{ bg_grayscale }}%; --pw-bg-sepia: {{ bg_sepia }}%; --pw-bg-invert: {{ bg_invert }}%;"
      {% endif %}
      {{ bg_block.shopify_attributes }}
    >
      {%- if bg_show_video and bg_video_url != blank -%}
        <video
          class="drift-password__bg-media"
          autoplay
          loop
          muted
          playsinline
          aria-hidden="true"
        >
          <source src="{{ bg_video_url }}" type="video/mp4">
        </video>
      {%- elsif bg_show_image and bg_image != blank -%}
        <img
          class="drift-password__bg-media"
          src="{{ bg_image | image_url: width: 1920 }}"
          srcset="{{ bg_image | image_url: width: 960 }} 960w, {{ bg_image | image_url: width: 1440 }} 1440w, {{ bg_image | image_url: width: 1920 }} 1920w"
          sizes="100vw"
          alt=""
          loading="eager"
          aria-hidden="true"
        >
      {%- endif -%}

      {%- if bg_overlay > 0 -%}
        <span class="drift-password__bg-overlay" style="opacity: {{ bg_overlay | divided_by: 100.0 }};"></span>
      {%- endif -%}
    </span>
  {%- else -%}
    <span class="drift-password__bg"></span>
  {%- endif -%}

  {%- comment -%} ── Logo ── {%- endcomment -%}
  <span class="drift-password__header{% if section.settings.logo_container %} drift-glass drift-password__header--pill{% endif %}">
    {%- if logo != blank and logo_dark != blank -%}
      <img
        src="{{ logo | image_url: height: logo_height_2x }}"
        srcset="{{ logo | image_url: height: logo_height }} 1x, {{ logo | image_url: height: logo_height_2x }} 2x"
        alt="{{ logo.alt | default: shop.name | escape }}"
        height="{{ logo_height }}"
        loading="eager"
        class="drift-password__logo drift-password__logo--light"
        style="height: {{ logo_height }}px;"
      >
      <img
        src="{{ logo_dark | image_url: height: logo_height_2x }}"
        srcset="{{ logo_dark | image_url: height: logo_height }} 1x, {{ logo_dark | image_url: height: logo_height_2x }} 2x"
        alt="{{ logo_dark.alt | default: shop.name | escape }}"
        height="{{ logo_height }}"
        loading="eager"
        class="drift-password__logo drift-password__logo--dark"
        style="height: {{ logo_height }}px;"
      >
    {%- elsif logo != blank -%}
      <img
        src="{{ logo | image_url: height: logo_height_2x }}"
        srcset="{{ logo | image_url: height: logo_height }} 1x, {{ logo | image_url: height: logo_height_2x }} 2x"
        alt="{{ logo.alt | default: shop.name | escape }}"
        height="{{ logo_height }}"
        loading="eager"
        class="drift-password__logo"
        style="height: {{ logo_height }}px;"
      >
    {%- elsif logo_dark != blank -%}
      <img
        src="{{ logo_dark | image_url: height: logo_height_2x }}"
        srcset="{{ logo_dark | image_url: height: logo_height }} 1x, {{ logo_dark | image_url: height: logo_height_2x }} 2x"
        alt="{{ logo_dark.alt | default: shop.name | escape }}"
        height="{{ logo_height }}"
        loading="eager"
        class="drift-password__logo"
        style="height: {{ logo_height }}px;"
      >
    {%- else -%}
      <svg class="drift-password__logo-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 547.94 547.93" fill="currentColor" aria-label="{{ shop.name }}" style="height: {{ logo_height }}px; width: auto;">
        <path d="M440.56,383.47c-60.48,0-109.51-49.03-109.51-109.51s49.03-109.51,109.51-109.51c53.1,0,97.37,37.8,107.38,87.96C537.49,117.84,430.11,10.45,295.53,0c50.15,10.02,87.94,54.28,87.94,107.37,0,60.48-49.03,109.51-109.51,109.51s-109.51-49.03-109.51-109.51c.01-53.09,37.8-97.35,87.95-107.37C117.82,10.45,10.44,117.84,0,252.42c10.01-50.16,54.27-87.97,107.38-87.97,60.48,0,109.51,49.03,109.51,109.51s-49.03,109.51-109.51,109.51c-53.1,0-97.37-37.8-107.38-87.97,10.44,134.6,117.85,242,252.45,252.43-50.17-10-87.99-54.27-87.99-107.38,0-60.48,49.03-109.51,109.51-109.51s109.51,49.03,109.51,109.51c0,53.11-37.82,97.38-87.99,107.38,134.6-10.43,242.01-117.83,252.45-252.43-10.01,50.16-54.27,87.97-107.38,87.97Z"/>
        <path d="M53.06,233.41h23.15l8.33,45.41,12.2-45.41h23.07l12.23,45.34,8.34-45.34h23.03l-17.39,81.11h-23.9l-13.83-51.06-13.78,51.06h-23.9l-17.55-81.11h0Z"/>
        <path d="M397.65,233.41h55.45c9.24,0,16.34,1.94,21.29,5.81s7.42,8.67,7.42,14.38c0,4.79-1.77,8.91-5.3,12.34-2.35,2.29-5.8,4.09-10.33,5.42,6.89,1.4,11.96,3.81,15.2,7.22,3.25,3.41,4.87,7.7,4.87,12.86,0,4.2-1.16,7.99-3.47,11.34-2.31,3.36-5.47,6.01-9.48,7.97-2.48,1.22-6.23,2.1-11.25,2.66-6.67.74-11.09,1.11-13.27,1.11h-51.14v-81.11h0ZM427.53,265.22h12.88c4.62,0,7.84-.67,9.65-2.02,1.81-1.35,2.71-3.29,2.71-5.84,0-2.36-.9-4.2-2.71-5.53s-4.96-1.99-9.45-1.99h-13.08v15.38ZM427.53,297.09h15.11c5.1,0,8.7-.77,10.79-2.3s3.14-3.59,3.14-6.17c0-2.4-1.04-4.32-3.11-5.78-2.07-1.46-5.7-2.19-10.89-2.19h-15.04v16.43h0Z"/>
        <path d="M234.18,63.45h78.15v17.32h-48.92v12.89h45.38v16.54h-45.38v15.99h50.34v18.37h-79.56V63.45h0Z"/>
        <path d="M234.97,396.29h47.21c10.28,0,17.98,2.16,23.1,6.47,5.12,4.32,7.68,10.46,7.68,18.42s-2.79,14.59-8.37,19.2-14.1,6.92-25.55,6.92h-15.55v30.1h-28.52v-81.11h0ZM263.49,430.87h6.96c5.48,0,9.32-.84,11.54-2.52s3.32-3.83,3.32-6.45-.96-4.7-2.88-6.47-5.54-2.66-10.85-2.66h-8.09v18.09h0Z"/>
      </svg>
    {%- endif -%}
  </span>

  {%- comment -%} ── Main Card ── {%- endcomment -%}
  <span class="drift-password__body">
    <span class="drift-password__card drift-glass">

      {%- if heading != blank -%}
        <h1 class="drift-password__heading">{{ heading | escape }}</h1>
      {%- endif -%}

      {%- if subtext != blank -%}
        <span class="drift-password__subtext">{{ subtext }}</span>
      {%- endif -%}

      {%- comment -%} ── Countdown Timer Block ── {%- endcomment -%}
      {%- if countdown_block -%}
        {%- liquid
          assign cd_year = countdown_block.settings.countdown_year
          assign cd_month = countdown_block.settings.countdown_month
          assign cd_day = countdown_block.settings.countdown_day
          assign cd_hour = countdown_block.settings.countdown_hour
          assign cd_minute = countdown_block.settings.countdown_minute
          assign cd_live_text = countdown_block.settings.countdown_live_text | default: 'The drop is live.'
          assign cd_live_heading = countdown_block.settings.countdown_live_heading
          assign cd_live_subtext = countdown_block.settings.countdown_live_subtext
          assign cd_password = countdown_block.settings.countdown_password
          assign cd_timezone = countdown_block.settings.countdown_timezone | default: 'America/New_York'
        -%}
        <span
          class="drift-countdown"
          data-drift-countdown
          data-countdown-year="{{ cd_year }}"
          data-countdown-month="{{ cd_month }}"
          data-countdown-day="{{ cd_day }}"
          data-countdown-hour="{{ cd_hour }}"
          data-countdown-minute="{{ cd_minute }}"
          {% if cd_password != blank %}data-countdown-pw="{{ cd_password | escape }}"{% endif %}
          data-countdown-tz="{{ cd_timezone }}"
          {% if cd_live_heading != blank %}data-countdown-live-heading="{{ cd_live_heading | escape }}"{% endif %}
          {% if cd_live_subtext != blank %}data-countdown-live-subtext="{{ cd_live_subtext | escape }}"{% endif %}
          {{ countdown_block.shopify_attributes }}
        >
          <span class="drift-countdown__grid">
            <span class="drift-countdown__unit">
              <span class="drift-countdown__number" data-countdown-days>00</span>
              <span class="drift-countdown__label">Days</span>
            </span>
            <span class="drift-countdown__sep">:</span>
            <span class="drift-countdown__unit">
              <span class="drift-countdown__number" data-countdown-hours>00</span>
              <span class="drift-countdown__label">Hours</span>
            </span>
            <span class="drift-countdown__sep">:</span>
            <span class="drift-countdown__unit">
              <span class="drift-countdown__number" data-countdown-mins>00</span>
              <span class="drift-countdown__label">Min</span>
            </span>
            <span class="drift-countdown__sep">:</span>
            <span class="drift-countdown__unit">
              <span class="drift-countdown__number" data-countdown-secs>00</span>
              <span class="drift-countdown__label">Sec</span>
            </span>
          </span>
          <span class="drift-countdown__live" data-countdown-live style="display:none;">
            <span class="drift-countdown__live-text">{{ cd_live_text | escape }}</span>
            {%- if cd_password != blank -%}
              <button type="button" class="drift-btn drift-btn--primary drift-countdown__enter" data-countdown-enter>
                Enter Site
              </button>
            {%- endif -%}
          </span>
        </span>
      {%- endif -%}

      {%- comment -%} Newsletter form ── {%- endcomment -%}
      {%- if show_newsletter -%}
        <span class="drift-password__newsletter">
          {%- if newsletter_heading != blank -%}
            <span class="drift-password__newsletter-heading">{{ newsletter_heading | escape }}</span>
          {%- endif -%}
          {%- if newsletter_subtext != blank -%}
            <span class="drift-password__newsletter-subtext">{{ newsletter_subtext | escape }}</span>
          {%- endif -%}

          {%- form 'customer', id: 'drift-password-newsletter' -%}
            <input type="hidden" name="contact[tags]" value="newsletter,password-page">
            <span class="drift-password__form-row">
              <input
                type="email"
                name="contact[email]"
                class="drift-password__input"
                placeholder="Email address"
                autocomplete="email"
                required
                aria-label="Email address"
              >
              <button type="submit" class="drift-btn drift-btn--primary drift-password__submit">
                Sign Up
              </button>
            </span>

            {%- if form.posted_successfully? -%}
              <span class="drift-password__form-success">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                You're on the list. We'll be in touch.
              </span>
            {%- endif -%}

            {%- if form.errors -%}
              <span class="drift-password__form-error">
                {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
              </span>
            {%- endif -%}
          {%- endform -%}
        </span>
      {%- endif -%}

      {%- comment -%} Custom Liquid blocks (Klaviyo, etc.) ── {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'custom_liquid' -%}
          <span class="drift-password__custom-block" {{ block.shopify_attributes }}>
            {{ block.settings.custom_liquid }}
          </span>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} Enter password link ── {%- endcomment -%}
      <button type="button" class="drift-btn drift-btn--outline drift-password__enter-link" data-password-open>
        {{ section.settings.password_link_text | default: 'Enter with password' | escape }}
      </button>

    </span>
  </span>

  {%- comment -%} ── Password Modal ── {%- endcomment -%}
  <span class="drift-password__modal{% if secret_link %} is-open{% endif %}" data-password-modal>
    <span class="drift-password__modal-backdrop" data-password-close aria-hidden="true"></span>
    <span class="drift-password__modal-card drift-glass">
      <span class="drift-password__modal-header">
        <span class="drift-password__modal-title">Enter Password</span>
        <button type="button" class="drift-icon-btn drift-password__modal-close" data-password-close aria-label="Close">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </span>

      {%- form 'storefront_password', id: 'drift-password-form' -%}
        <span class="drift-password__modal-body">
          <input
            type="password"
            name="password"
            class="drift-password__input"
            placeholder="Password"
            autocomplete="current-password"
            autofocus
            aria-label="Password"
          >
          <button type="submit" class="drift-btn drift-btn--primary drift-password__submit drift-password__submit--full">
            Enter
          </button>

          {%- if form.errors -%}
            <span class="drift-password__form-error">
              Wrong password. Please try again.
            </span>
          {%- endif -%}
        </span>
      {%- endform -%}
    </span>
  </span>

  {%- comment -%} ── Footer ── {%- endcomment -%}
  <span class="drift-password__footer">
    {%- if section.settings.show_socials -%}
      {%- liquid
        assign has_socials = false
        if settings.social_instagram_link != blank or settings.social_tiktok_link != blank or settings.social_youtube_link != blank or settings.social_twitter_link != blank or settings.social_facebook_link != blank
          assign has_socials = true
        endif
      -%}
      {%- if has_socials -%}
        <span class="drift-password__socials">
          {% render 'social-icons', class: 'drift-password__social-list' %}
        </span>
      {%- endif -%}
    {%- endif -%}
    <span class="drift-password__copyright">
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
    </span>
    <span class="drift-password__credit">
      Powered by <a href="https://webexp.dev" target="_blank" rel="noopener">WEBEXP</a>
    </span>
  </span>
</div>

<style>
  /* ============================================
     DRIFT Password Page — Scoped Styles
     ============================================ */

  .drift-password {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--drift-space-3);
    padding: var(--drift-space-3);
    z-index: var(--drift-z-modal);
    color: var(--drift-text);
    overflow-y: auto;
  }

  /* ── Background ── */
  .drift-password__bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    background-color: var(--drift-bg);
    transition: background-color var(--drift-duration-normal) var(--drift-ease);
    overflow: hidden;
  }

  .drift-password__bg-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter:
      blur(var(--pw-bg-blur, 0px))
      brightness(var(--pw-bg-brightness, 100%))
      hue-rotate(var(--pw-bg-hue, 0deg))
      grayscale(var(--pw-bg-grayscale, 0%))
      sepia(var(--pw-bg-sepia, 0%))
      invert(var(--pw-bg-invert, 0%));
  }

  .drift-password__bg-overlay {
    position: absolute;
    inset: 0;
    background-color: var(--drift-bg);
    pointer-events: none;
  }

  /* ── Color mode override ── */
  .drift-password[data-drift-mode="dark"] {
    --drift-bg: #0A0A0A;
    --drift-text: #F5F5F7;
    --drift-text-muted: #86868B;
    --drift-border: rgba(255, 255, 255, 0.08);
    --drift-glass-bg: rgba(28, 28, 30, 0.55);
    --drift-glass-border: rgba(255, 255, 255, 0.08);
    --drift-glass-shadow: 0 2px 16px rgba(0, 0, 0, 0.3);
    --drift-surface: rgba(28, 28, 30, 0.6);
    --drift-btn-primary-bg: #F5F5F7;
    --drift-btn-primary-text: #1D1D1F;
  }

  .drift-password[data-drift-mode="light"] {
    --drift-bg: #FAFAFA;
    --drift-text: #1D1D1F;
    --drift-text-muted: #86868B;
    --drift-border: rgba(0, 0, 0, 0.06);
    --drift-glass-bg: rgba(255, 255, 255, 0.55);
    --drift-glass-border: rgba(255, 255, 255, 0.4);
    --drift-glass-shadow: 0 2px 16px rgba(0, 0, 0, 0.06);
    --drift-surface: rgba(255, 255, 255, 0.6);
    --drift-btn-primary-bg: #1D1D1F;
    --drift-btn-primary-text: #FFFFFF;
  }

  /* ── Header / Logo ── */
  .drift-password__header {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .drift-password__header--pill {
    width: fit-content;
    padding: var(--drift-space-1);
    border-radius: var(--drift-radius-full);
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .drift-password__header--pill .drift-password__logo,
  .drift-password__header--pill .drift-password__logo-svg {
    border-radius: var(--drift-radius-full);
  }

  .drift-password__logo {
    display: block;
    object-fit: contain;
    width: auto;
  }

  .drift-password__logo-svg {
    display: block;
    color: var(--drift-text);
  }

  .drift-password__logo--dark { display: none; }
  .drift-password[data-drift-mode="dark"] .drift-password__logo--light { display: none; }
  .drift-password[data-drift-mode="dark"] .drift-password__logo--dark { display: block; }

  .drift-password__shop-name {
    font-family: var(--drift-font-heading);
    font-size: var(--drift-text-xl);
    font-weight: var(--drift-weight-bold);
    letter-spacing: var(--drift-tracking-wide);
    text-transform: uppercase;
    color: var(--drift-text);
  }

  /* ── Layout — Spread vs Compact ── */
  .drift-password__body {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .drift-password--spread .drift-password__body {
    flex: 1;
    align-items: center;
  }

  .drift-password--compact {
    justify-content: center;
  }

  .drift-password--compact .drift-password__body {
    flex: 0;
    align-items: center;
  }

  /* ── Body / Card ── */
  .drift-password__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0;
    width: 100%;
    max-width: 480px;
    padding: var(--drift-space-4);
    border-radius: var(--drift-radius-lg);
  }

  @media (max-width: 1023px) {
    .drift-password__card {
      padding: var(--drift-space-3);
    }
  }

  .drift-password__heading {
    font-family: var(--drift-font-heading);
    font-size: var(--drift-text-2xl);
    font-weight: var(--drift-weight-bold);
    letter-spacing: var(--drift-tracking-tight);
    line-height: var(--drift-leading-tight);
    color: var(--drift-text);
    margin: 0 0 var(--drift-space-1) 0;
  }

  @media (max-width: 1023px) {
    .drift-password__heading {
      font-size: var(--drift-text-xl);
    }
  }

  .drift-password__subtext {
    font-size: var(--drift-text-sm);
    line-height: var(--drift-leading-relaxed);
    color: var(--drift-text-muted);
    max-width: 360px;
  }

  .drift-password__subtext p { margin: 0; }

  /* ── Countdown Timer ── */
  .drift-countdown {
    display: flex;
    flex-direction: column;
    align-items: center;
