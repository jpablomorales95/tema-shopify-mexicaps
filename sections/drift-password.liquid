    background-color: var(--drift-surface);
    border: 1px solid var(--drift-border);
    border-radius: var(--drift-radius-sm);
    outline: none;
    transition: border-color var(--drift-duration-fast) var(--drift-ease);
    -webkit-appearance: none;
    appearance: none;
    min-height: 48px;
