    border-radius: var(--drift-radius-lg);
    transform: scale(0.95) translateY(10px);
    transition: transform var(--drift-duration-normal) var(--drift-ease);
  }

  .drift-password__modal.is-open .drift-password__modal-card {
    transform: scale(1) translateY(0);
  }

  .drift-password__modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
