      padding: var(--drift-space-1) 6px;
    }

    .drift-countdown__number {
      font-size: var(--drift-text-base);
    }

    .drift-countdown__grid {
      gap: var(--drift-space-1);
    }

    .drift-countdown__sep {
      font-size: var(--drift-text-base);
      padding-bottom: 14px;
    }
  }

  /* ── Newsletter ── */
  .drift-password__newsletter {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--drift-space-1);
    width: 100%;
    margin-top: var(--drift-space-3);
    text-align: center;
  }

  .drift-password__newsletter-heading {
    font-size: var(--drift-text-sm);
    font-weight: var(--drift-weight-semibold);
    letter-spacing: var(--drift-tracking-caps);
    text-transform: uppercase;
    color: var(--drift-text);
  }

  .drift-password__newsletter-subtext {
