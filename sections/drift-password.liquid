    width: 20px;
    height: 20px;
    stroke-width: 2;
  }

  .drift-password__modal-body {
    display: flex;
    flex-direction: column;
    gap: var(--drift-space-2);
  }

  /* ── Footer ── */
  .drift-password__footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .drift-password__socials {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .drift-password__socials .drift-password__social-list {
