<script>
  (function () {
    /* ── Password Modal ── */
    var modal = document.querySelector('[data-password-modal]');
    if (modal) {
      var openBtns = document.querySelectorAll('[data-password-open]');
      var closeBtns = modal.querySelectorAll('[data-password-close]');
      var input = modal.querySelector('input[name="password"]');

      function open() {
        modal.classList.add('is-open');
        document.body.style.overflow = 'hidden';
        if (input) setTimeout(function () { input.focus(); }, 100);
      }

      function close() {
        modal.classList.remove('is-open');
        document.body.style.overflow = '';
      }

      openBtns.forEach(function (btn) { btn.addEventListener('click', open); });
      closeBtns.forEach(function (btn) { btn.addEventListener('click', close); });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && modal.classList.contains('is-open')) {
          e.preventDefault();
          close();
        }
      });

      if (modal.querySelector('.drift-password__form-error')) {
        open();
      }
    }

    /* ── Countdown Timer ── */
    var cd = document.querySelector('[data-drift-countdown]');
    if (!cd) return;

    var y = parseInt(cd.dataset.countdownYear, 10);
    var m = parseInt(cd.dataset.countdownMonth, 10);
    var d = parseInt(cd.dataset.countdownDay, 10);
    var h = parseInt(cd.dataset.countdownHour, 10) || 0;
    var mn = parseInt(cd.dataset.countdownMinute, 10) || 0;
    var tz = cd.dataset.countdownTz || 'America/New_York';

    if (!y || !m || !d) return;

    /* Build an ISO string in the merchant's timezone and convert to UTC timestamp */
    var pad2 = function (n) { return n < 10 ? '0' + n : String(n); };
    var isoStr = y + '-' + pad2(m) + '-' + pad2(d) + 'T' + pad2(h) + ':' + pad2(mn) + ':00';

    /* Use Intl to find the UTC offset for the merchant's timezone at the target date */
    var target;
    try {
      var fmt = new Intl.DateTimeFormat('en-US', {
        timeZone: tz,
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit', second: '2-digit',
        hour12: false
      });
      var local = new Date(isoStr);
      var parts = fmt.formatToParts(local);
      var get = function (type) {
        for (var i = 0; i < parts.length; i++) {
          if (parts[i].type === type) return parseInt(parts[i].value, 10);
        }
        return 0;
      };
      var tzDate = new Date(get('year'), get('month') - 1, get('day'), get('hour'), get('minute'), get('second'));
      var offset = tzDate.getTime() - local.getTime();
      target = local.getTime() - offset;
    } catch (e) {
      target = new Date(y, m - 1, d, h, mn, 0).getTime();
    }

    var $d = cd.querySelector('[data-countdown-days]');
    var $h = cd.querySelector('[data-countdown-hours]');
    var $m = cd.querySelector('[data-countdown-mins]');
    var $s = cd.querySelector('[data-countdown-secs]');
    var $grid = cd.querySelector('.drift-countdown__grid');
    var $live = cd.querySelector('[data-countdown-live]');
    var pw = cd.dataset.countdownPw || '';
    var liveHeading = cd.dataset.countdownLiveHeading || '';
    var liveSubtext = cd.dataset.countdownLiveSubtext || '';

    function pad(n) { return n < 10 ? '0' + n : String(n); }

    function onDropLive() {
      $grid.style.display = 'none';
      $live.style.display = '';

      /* Swap heading + subtext to live versions */
      var heading = document.querySelector('.drift-password__heading');
      var subtext = document.querySelector('.drift-password__subtext');
      if (heading && liveHeading) heading.textContent = liveHeading;
      if (subtext && liveSubtext) subtext.textContent = liveSubtext;

      /* Hide elements no longer needed */
      var newsletter = document.querySelector('.drift-password__newsletter');
      var enterPw = document.querySelector('.drift-password__enter-link');
      if (newsletter) newsletter.style.display = 'none';
      if (enterPw) enterPw.style.display = 'none';
    }

    /* Enter Site button — auto-fills password form and submits */
    var enterBtn = cd.querySelector('[data-countdown-enter]');
    if (enterBtn && pw) {
      enterBtn.addEventListener('click', function () {
        enterBtn.textContent = 'Entering...';
        enterBtn.disabled = true;
        var form = document.querySelector('#drift-password-form');
        var input = form ? form.querySelector('input[name="password"]') : null;
        if (form && input) {
          input.value = pw;
          form.submit();
        }
      });
    }

    function tick() {
      var now = Date.now();
      var diff = target - now;

      if (diff <= 0) {
        onDropLive();
        return;
      }

      var days = Math.floor(diff / 86400000);
      var hrs = Math.floor((diff % 86400000) / 3600000);
      var mins = Math.floor((diff % 3600000) / 60000);
      var secs = Math.floor((diff % 60000) / 1000);

      $d.textContent = pad(days);
      $h.textContent = pad(hrs);
      $m.textContent = pad(mins);
      $s.textContent = pad(secs);

      requestAnimationFrame(function () {
        setTimeout(tick, 1000 - (Date.now() % 1000));
      });
    }

    tick();
  })();
</script>

