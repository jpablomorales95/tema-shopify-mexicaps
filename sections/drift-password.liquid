  }

  .drift-password__modal.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .drift-password__modal-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.5);
    cursor: pointer;
  }

  .drift-password__modal-card {
