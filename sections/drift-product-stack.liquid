{% comment %}
  ============================================
  DRIFT Theme by WEBEXP, LLC
  DRIFT Product Stack — Vertical Media + Floating Info Panel
  https://webexp.dev
  ============================================
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign media_count = product.media.size
  assign nav_style = section.settings.media_nav_style
  assign media_ratio = section.settings.media_ratio
  assign video_playback = section.settings.video_playback
  assign desktop_layout = section.settings.desktop_layout
  assign media_zoom = section.settings.media_zoom | default: 'none'
  assign size_chart = product.metafields.custom.size_chart.value
  assign low_stock_enabled = section.settings.low_stock_enabled
  assign low_stock_threshold = section.settings.low_stock_threshold | default: 5
  assign from_drift = false
  if request.path contains '?from=drift'
    assign from_drift = true
  endif

  comment
    Pre-order metafield (custom.is_preorder boolean, custom.preorder_text single line).
    When is_preorder is true AND the variant is available, the ATC button label is
    swapped from "Add to Cart" to the merchant's preorder text. Disabled / "Sold Out"
    behavior is unchanged — pre-order is a label, not a stock bypass.
  endcomment
  assign is_preorder = product.metafields.custom.is_preorder
  assign preorder_text = product.metafields.custom.preorder_text
  if preorder_text == blank
    assign preorder_text = 'Pre-Order'
  endif

  assign hide_default_atc = section.settings.hide_default_atc
-%}

{{ 'combo-widgets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'combo-widgets.js' | asset_url }}" defer></script>

<div
  class="drift-pdp"
  data-section-id="{{ section.id }}"
  data-section-type="drift-product-stack"
  data-product-url="{{ product.url }}.js"
  data-nav-style="{{ nav_style }}"
  data-media-ratio="{{ media_ratio }}"
  data-video-playback="{{ video_playback }}"
  data-desktop-layout="{{ desktop_layout }}"
  data-media-zoom="{{ media_zoom }}"
  {% if low_stock_enabled %}data-low-stock-threshold="{{ low_stock_threshold }}"{% endif %}
>

  {%- comment -%} Back to Feed {%- endcomment -%}
  {%- if from_drift -%}
    <a href="{{ routes.root_url }}collections/{{ product.collections.first.handle }}" class="drift-pdp__back drift-glass drift-glass--subtle">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5"/>
        <path d="M12 19l-7-7 7-7"/>
      </svg>
      <span>Back to Feed</span>
    </a>
  {%- endif -%}

  {%- comment -%} ════════ MEDIA ════════ {%- endcomment -%}
  <div class="drift-pdp__media">
    {% render 'drift-badge', product: product %}

    {%- comment -%} Desktop: vertical scroll track {%- endcomment -%}
    <div class="drift-pdp__media-track drift-pdp__media-track--desktop" data-pdp-track="desktop">
      {%- for media in product.media limit: 20 -%}
        {%- if media.media_type == 'model' -%}
          {%- assign model_poster_desktop = media.preview_image | image_url: width: 1400 -%}
        {%- endif -%}
        <span
          class="drift-pdp__media-slide"
          data-pdp-slide="{{ forloop.index0 }}"
          data-media-type="{{ media.media_type }}"
        >
          {%- case media.media_type -%}
            {%- when 'image' -%}
              <img
                src="{{ media | image_url: width: 1400 }}"
                srcset="
                  {{ media | image_url: width: 800 }} 800w,
                  {{ media | image_url: width: 1100 }} 1100w,
                  {{ media | image_url: width: 1400 }} 1400w,
                  {{ media | image_url: width: 1800 }} 1800w
                "
                sizes="100vw"
                alt="{{ media.alt | default: product.title | escape }}"
                width="{{ media.width }}"
                height="{{ media.height }}"
                class="drift-pdp__image"
                data-magnify-src="{{ media | image_url: width: 2400 }}"
                {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                draggable="false"
              >
            {%- when 'video', 'external_video' -%}
              <span class="drift-pdp__video-wrap" data-pdp-video-wrap>
                {%- if video_playback == 'autoplay' -%}
                  {{ media | media_tag: class: 'drift-pdp__video', autoplay: true, muted: true, loop: true, playsinline: true }}
                {%- else -%}
                  {{ media | media_tag: class: 'drift-pdp__video', autoplay: false, muted: true, loop: true, playsinline: true, controls: true }}
                {%- endif -%}
              </span>
            {%- when 'model' -%}
              <span class="drift-pdp__model-wrap">
                {{ media | model_viewer_tag: class: 'drift-pdp__model', ar: true, ar-modes: 'webxr scene-viewer quick-look', camera-controls: true, poster: model_poster_desktop, loading: 'lazy' }}
              </span>
          {%- endcase -%}
        </span>
      {%- endfor -%}
    </div>

    {%- comment -%} Mobile: horizontal scroll track {%- endcomment -%}
    <div class="drift-pdp__media-track drift-pdp__media-track--mobile" data-pdp-track="mobile">
      {%- for media in product.media limit: 20 -%}
        {%- if media.media_type == 'model' -%}
          {%- assign model_poster_mobile = media.preview_image | image_url: width: 900 -%}
        {%- endif -%}
          <span
          class="drift-pdp__media-slide"
          data-pdp-slide="{{ forloop.index0 }}"
          data-media-type="{{ media.media_type }}"
        >
          {%- case media.media_type -%}
            {%- when 'image' -%}
              <img
                src="{{ media | image_url: width: 900 }}"
                srcset="
                  {{ media | image_url: width: 400 }} 400w,
                  {{ media | image_url: width: 600 }} 600w,
                  {{ media | image_url: width: 900 }} 900w
                "
                sizes="100vw"
                alt="{{ media.alt | default: product.title | escape }}"
                width="{{ media.width }}"
                height="{{ media.height }}"
                class="drift-pdp__image"
                {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                draggable="false"
              >
            {%- when 'video', 'external_video' -%}
              <span class="drift-pdp__video-wrap" data-pdp-video-wrap>
                {%- if video_playback == 'autoplay' -%}
                  {{ media | media_tag: class: 'drift-pdp__video', autoplay: true, muted: true, loop: true, playsinline: true }}
                {%- else -%}
                  {{ media | media_tag: class: 'drift-pdp__video', autoplay: false, muted: true, loop: true, playsinline: true, controls: true }}
                {%- endif -%}
              </span>
            {%- when 'model' -%}
              <span class="drift-pdp__model-wrap">
                {{ media | model_viewer_tag: class: 'drift-pdp__model', ar: true, ar-modes: 'webxr scene-viewer quick-look', camera-controls: true, poster: model_poster_mobile, loading: 'lazy' }}
              </span>
          {%- endcase -%}
        </span>
      {%- endfor -%}
    </div>

    {%- comment -%} ════════ MEDIA NAV ════════ {%- endcomment -%}
    {%- if media_count > 1 -%}

      {%- comment -%} Thumbnails {%- endcomment -%}
      {%- if nav_style == 'thumbnails' -%}
        <span class="drift-pdp__thumbs drift-glass drift-glass--subtle" data-pdp-thumbs>
          {%- for media in product.media limit: 20 -%}
            <button
              class="drift-pdp__thumb{% if forloop.first %} is-active{% endif %}"
              data-pdp-thumb="{{ forloop.index0 }}"
              type="button"
              aria-label="View {{ media.media_type | default: 'image' }} {{ forloop.index }}"
            >
              {%- if media.media_type == 'image' -%}
                <img
                  src="{{ media | image_url: width: 80 }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  width="40"
                  height="40"
                  class="drift-pdp__thumb-img"
                  loading="lazy"
                  draggable="false"
                >
              {%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}
                <span class="drift-pdp__thumb-overlay">
                  <img
                    src="{{ media.preview_image | image_url: width: 80 }}"
                    alt="{{ media.alt | default: product.title | escape }}"
                    width="40"
                    height="40"
                    class="drift-pdp__thumb-img"
                    loading="lazy"
                    draggable="false"
                  >
                  <span class="drift-pdp__thumb-badge">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                  </span>
                </span>
              {%- elsif media.media_type == 'model' -%}
                <span class="drift-pdp__thumb-overlay">
                  <img
                    src="{{ media.preview_image | image_url: width: 80 }}"
                    alt="{{ media.alt | default: product.title | escape }}"
                    width="40"
                    height="40"
                    class="drift-pdp__thumb-img"
                    loading="lazy"
                    draggable="false"
                  >
                  <span class="drift-pdp__thumb-badge">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"/><path d="M12 12l8-4.5"/><path d="M12 12v9"/><path d="M12 12L4 7.5"/></svg>
                  </span>
                </span>
              {%- endif -%}
            </button>
          {%- endfor -%}
        </span>
      {%- endif -%}

      {%- comment -%} Dots {%- endcomment -%}
      {%- if nav_style == 'dots' -%}
        <span class="drift-pdp__dots" data-pdp-dots>
          {%- for media in product.media limit: 20 -%}
            <button
              class="drift-pdp__dot{% if forloop.first %} is-active{% endif %}"
              data-pdp-dot="{{ forloop.index0 }}"
              type="button"
              aria-label="View image {{ forloop.index }}"
            ></button>
          {%- endfor -%}
        </span>
      {%- endif -%}

      {%- comment -%} Counter {%- endcomment -%}
      {%- if nav_style == 'counter' -%}
        <span class="drift-pdp__counter drift-glass drift-glass--subtle" data-pdp-counter>
          <span data-pdp-counter-current>1</span>
          <span class="drift-pdp__counter-sep"></span>
          <span data-pdp-counter-total>{{ media_count }}</span>
        </span>
      {%- endif -%}

    {%- endif -%}
  </div>

  {%- comment -%} ════════ INFO PANEL ════════ {%- endcomment -%}
  <div class="drift-pdp__panel drift-glass" data-pdp-panel>

    {%- comment -%} Mobile drag handle {%- endcomment -%}
    <span class="drift-pdp__panel-handle" data-pdp-handle>
      <span class="drift-pdp__panel-handle-bar"></span>
    </span>

    {%- comment -%} Peek: title + Addi banner {%- endcomment -%}
    <div class="drift-pdp__panel-peek" data-pdp-peek>
      <h1 class="drift-pdp__title">{{ product.title | escape }}</h1>
      {% render 'mxcs-addi-banner', product: product, variant: current_variant %}
    </div>

    {%- comment -%} Full content (mobile: swipe up / desktop: always visible) {%- endcomment -%}
    <div class="drift-pdp__panel-full" data-pdp-full>

      {%- comment -%} Description {%- endcomment -%}
      {%- if product.description != blank -%}
        <div class="drift-pdp__description">
          <div class="drift-pdp__description-inner" data-pdp-description>
            {{ product.description }}
          </div>
          <button class="drift-pdp__description-toggle" data-pdp-description-toggle type="button" hidden>
            <span data-pdp-description-toggle-text>Show More</span>
          </button>
        </div>
      {%- endif -%}

      {%- comment -%} Colorways — linked product swatches (V3) {%- endcomment -%}
      {%- assign colorways = product.metafields.custom.colorways.value -%}
      {%- if colorways != blank and colorways.size > 0 -%}
        {%- assign current_color = product.metafields.custom.colorway_color | default: '#888888' -%}
        <div class="drift-pdp__colorways">
          <span class="drift-pdp__colorway-label">Colorways</span>
          <div class="drift-pdp__colorway-dots">
            {%- comment -%} Current product dot {%- endcomment -%}
            <span
              class="drift-pdp__colorway-dot is-active"
              style="--dot-color: {{ current_color }}"
              title="{{ product.title | escape }}"
              aria-label="Current: {{ product.title | escape }}"
            ></span>
            {%- comment -%} Linked product dots {%- endcomment -%}
            {%- for linked in colorways -%}
              {%- if linked.id != product.id -%}
                {%- assign linked_color = linked.metafields.custom.colorway_color | default: '#888888' -%}
                <a
                  href="{{ linked.url }}"
                  class="drift-pdp__colorway-dot"
                  style="--dot-color: {{ linked_color }}"
                  title="{{ linked.title | escape }}"
                  aria-label="{{ linked.title | escape }}"
                >&nbsp;</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} Variant selector {%- endcomment -%}
      {%- unless product.has_only_default_variant -%}
        <div class="drift-pdp__variants">
          {%- for option in product.options_with_values -%}
            <div class="drift-pdp__option">
              <span class="drift-pdp__option-label">
                {{ option.name }}
                <span class="drift-pdp__option-selected" data-option-selected="{{ forloop.index0 }}"></span>
              </span>
              <div class="drift-pdp__option-values">
                {%- for value in option.values -%}
                  <button
                    class="drift-pdp__option-btn"
                    data-option-index="{{ forloop.parentloop.index0 }}"
                    data-option-value="{{ value | escape }}"
                    type="button"
                  >
                    {{ value | escape }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endunless -%}

      {%- comment -%} Size chart trigger {%- endcomment -%}
      {%- if size_chart -%}
        <button class="drift-pdp__size-chart-trigger" data-pdp-size-chart-open type="button">
          Size Chart
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </button>
      {%- endif -%}
    </div>

    <div class="drift-pdp__atc-wrap" data-pdp-atc-wrap>

      {%- if low_stock_enabled -%}
        <span class="drift-pdp__low-stock" data-pdp-low-stock hidden>
          <span class="drift-pdp__low-stock-dot"></span>
          <span data-pdp-low-stock-text>Only {{ low_stock_threshold }} left</span>
        </span>
      {%- endif -%}

      {%- unless hide_default_atc -%}
        {%- unless product.has_only_default_variant -%}
          <button
            type="button"
            class="drift-btn drift-btn--primary drift-pdp__atc drift-pdp__atc--select"
            data-pdp-select-options
            {% unless product.available %}disabled{% endunless %}
          >
            <span class="drift-pdp__atc-text">{% if product.available %}Select Options{% else %}Sold Out{% endif %}</span>
            <span class="drift-pdp__atc-price">
              {%- if product.compare_at_price_max > product.price_min and product.price_varies == false -%}
                <s class="drift-pdp__compare">{{ product.compare_at_price_max | money_without_trailing_zeros }}</s>
              {%- endif -%}
              {%- if product.price_varies -%}
                From {{ product.price_min | money_without_trailing_zeros }}
              {%- else -%}
                {%- assign price_mod = current_variant.price | modulo: 100 -%}
                {%- if price_mod == 0 -%}
                  {{ current_variant.price | money_without_trailing_zeros }}
                {%- else -%}
                  {{ current_variant.price | money }}
                {%- endif -%}
              {%- endif -%}
            </span>
          </button>
        {%- endunless -%}

        <form method="post" action="/cart/add" class="drift-pdp__form" data-pdp-form>
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-pdp-variant-id>
          <input type="hidden" name="quantity" value="1">
          <button
            type="submit"
            class="drift-btn drift-btn--primary drift-pdp__atc drift-pdp__atc--submit{% unless product.has_only_default_variant %} drift-pdp__atc--hidden{% endunless %}"
            {% unless current_variant.available %}disabled{% endunless %}
            data-pdp-atc
            data-preorder="{% if is_preorder %}true{% else %}false{% endif %}"
            data-preorder-text="{{ preorder_text | escape }}"
          >
            <span class="drift-pdp__atc-text">
              {%- if current_variant.available and is_preorder -%}
                {{ preorder_text }}
              {%- elsif current_variant.available -%}
                Add to Cart
              {%- else -%}
                Sold Out
              {%- endif -%}
            </span>
            <span class="drift-pdp__atc-price" data-pdp-price>
              {%- if current_variant.compare_at_price > current_variant.price -%}
                <s class="drift-pdp__compare">{{ current_variant.compare_at_price | money_without_trailing_zeros }}</s>
              {%- endif -%}
              {%- assign price_mod = current_variant.price | modulo: 100 -%}
              {%- if price_mod == 0 -%}
                {{ current_variant.price | money_without_trailing_zeros }}
              {%- else -%}
                {{ current_variant.price | money }}
              {%- endif -%}
            </span>
          </button>
        </form>
      {%- endunless -%}

      {%- comment -%} Combo widgets — configurables como bloque de sección en el editor de temas {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'combo_widget' -%}
          <div {{ block.shopify_attributes }}>
            {%- case block.settings.combo_type -%}
              {%- when 'mix_match' -%}
                {% render 'combo-mixmatch',
                  product: product,
                  set_price: block.settings.set_price,
                  set_qty: block.settings.set_qty,
                  set_label: block.settings.set_label,
                  mode: block.settings.combo_mode,
                  pool_collection: block.settings.pool_collection,
                  pool_max_price: block.settings.pool_max_price,
                  combo_marker: block.settings.combo_marker,
                  redirect_checkout: block.settings.redirect_checkout
                %}
            {%- endcase -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>

  {%- comment -%} Mobile panel backdrop {%- endcomment -%}
  <span class="drift-pdp__backdrop" data-pdp-backdrop></span>

  {%- comment -%} ════════ SIZE CHART MODAL ════════ {%- endcomment -%}
  {%- if size_chart -%}
    <div class="drift-pdp__size-chart" data-pdp-size-chart>
      <span class="drift-pdp__size-chart-backdrop" data-pdp-size-chart-close></span>
      <div class="drift-pdp__size-chart-card drift-glass" data-pdp-size-chart-card>
        <div class="drift-pdp__size-chart-header">
          <span class="drift-pdp__size-chart-title">Size Chart</span>
          <button class="drift-icon-btn" data-pdp-size-chart-close type="button" aria-label="Close size chart">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"/>
              <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>
        <div class="drift-pdp__size-chart-body">
          <img
            src="{{ size_chart | image_url: width: 1200 }}"
            srcset="
              {{ size_chart | image_url: width: 600 }} 600w,
              {{ size_chart | image_url: width: 900 }} 900w,
              {{ size_chart | image_url: width: 1200 }} 1200w
            "
            sizes="(min-width: 1024px) 600px, 90vw"
            alt="Size chart for {{ product.title | escape }}"
            class="drift-pdp__size-chart-img"
            loading="lazy"
            draggable="false"
          >
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} Product JSON {%- endcomment -%}
  <script type="application/json" data-pdp-json>
    {{ product | json }}
  </script>

  {%- if low_stock_enabled -%}
    <script type="application/json" data-pdp-inventory>
      {
        {%- for variant in product.variants -%}
          "{{ variant.id }}": {{ variant.inventory_quantity | default: -1 }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      }
    </script>
  {%- endif -%}

  <script type="application/json" id="drift-pdp-variants">
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "price": {{ variant.price }},
          "compare_at_price": {{ variant.compare_at_price | default: 0 }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>

  <script type="application/json" data-pdp-prices>
    {
      {%- for variant in product.variants -%}
        "{{ variant.id }}": {
          "price": {{ variant.price | money_without_trailing_zeros | json }},
          "compare_at_price": {%- if variant.compare_at_price -%}{{ variant.compare_at_price | money_without_trailing_zeros | json }}{%- else -%}null{%- endif -%}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  </script>

</div>

{%- assign has_models = product.media | where: 'media_type', 'model' | size -%}
<script src="{{ 'drift-product.js' | asset_url }}" defer></script>
{%- if has_models > 0 -%}
  {{ 'component-model-viewer-ui.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'component-model-viewer-ui.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "DRIFT Product Stack",
  "tag": "section",
  "class": "drift-pdp-section",
  "settings": [
    {
      "type": "select",
      "id": "media_nav_style",
      "label": "Media navigation style",
      "info": "How customers navigate between product images.",
      "options": [
        { "value": "thumbnails", "label": "Thumbnails" },
        { "value": "dots", "label": "Dots" },
        { "value": "counter", "label": "Counter" }
      ],
      "default": "thumbnails"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Media aspect ratio",
      "info": "Constrains product media to a consistent ratio. Square works best for most products.",
      "options": [
        { "value": "1-1", "label": "Square (1:1)" },
        { "value": "3-4", "label": "Portrait (3:4)" }
      ],
      "default": "1-1"
    },
    {
      "type": "select",
      "id": "video_playback",
      "label": "Video playback",
      "info": "Autoplay starts videos when swiped into view. Manual requires the customer to press play.",
      "options": [
        { "value": "autoplay", "label": "Autoplay on scroll" },
        { "value": "manual", "label": "Manual play" }
      ],
      "default": "autoplay"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop layout",
      "info": "Controls vertical positioning of the info panel and media nav on desktop.",
      "options": [
        { "value": "bottom", "label": "Bottom-aligned" },
        { "value": "center", "label": "Center-aligned" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "media_zoom",
      "label": "Image zoom (Desktop)",
