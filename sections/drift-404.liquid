<section class="drift-404" data-section-type="drift-404">
  <span class="drift-404__container drift-container">
    <span class="drift-404__card drift-glass">
      <span class="drift-404__code">404</span>
      <span class="drift-404__heading">Lost in the drift</span>
      <span class="drift-404__body">The page you're looking for doesn't exist or has been moved.</span>
      <a href="{{ routes.root_url }}" class="drift-btn drift-btn--primary drift-404__btn">
        Back to Home
      </a>
    </span>
  </span>
</section>

{% schema %}
{
  "name": "DRIFT 404",
  "tag": "section",
  "class": "drift-404-section",
  "settings": []
}
{% endschema %}