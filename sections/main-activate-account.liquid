{% comment %}
  ============================================
  DRIFT Theme by WEBEXP, LLC
  Activate Account — Replaces Dawn's main-activate-account.liquid
  https://webexp.dev
  ============================================
{% endcomment %}

<section class="drift-customer" data-section-type="drift-customer-activate">
  <span class="drift-customer__container drift-container">
    <span class="drift-customer__stack">

      <span class="drift-customer__title-card drift-glass">
        <span class="drift-customer__title">{{ 'customer.activate_account.title' | t }}</span>
      </span>

      <span class="drift-customer__card drift-glass">
        <span class="drift-customer__subtitle">{{ 'customer.activate_account.subtext' | t }}</span>

        {%- form 'activate_customer_password' -%}
          {%- if form.errors -%}
            <span class="drift-customer__error">
              {{ form.errors | default_errors }}
            </span>
          {%- endif -%}

          <span class="drift-customer__field">
            <label class="drift-customer__label" for="password">{{ 'customer.activate_account.password' | t }}</label>
            <input
              class="drift-customer__input"
              type="password"
              name="customer[password]"
              id="password"
              autocomplete="new-password"
              placeholder="••••••••"
              {% if form.errors contains 'password' %}aria-invalid="true" aria-describedby="password-error"{% endif %}
            >
          </span>
          {%- if form.errors contains 'password' -%}
            <span class="drift-customer__error" id="password-error">
              {{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}
            </span>
          {%- endif -%}

          <span class="drift-customer__field">
            <label class="drift-customer__label" for="password_confirmation">{{ 'customer.activate_account.password_confirm' | t }}</label>
            <input
              class="drift-customer__input"
              type="password"
              name="customer[password_confirmation]"
              id="password_confirmation"
              autocomplete="new-password"
              placeholder="••••••••"
              {% if form.errors contains 'password_confirmation' %}aria-invalid="true" aria-describedby="password_confirmation-error"{% endif %}
            >
          </span>
          {%- if form.errors contains 'password_confirmation' -%}
            <span class="drift-customer__error" id="password_confirmation-error">
              {{ form.errors.translated_fields.password_confirmation | capitalize }} {{ form.errors.messages.password_confirmation }}
            </span>
          {%- endif -%}

          <button class="drift-btn drift-btn--primary drift-customer__submit" type="submit">
            {{ 'customer.activate_account.submit' | t }}
          </button>

          <button class="drift-btn drift-btn--ghost drift-customer__submit" type="submit" name="decline">
            {{ 'customer.activate_account.cancel' | t }}
          </button>
        {%- endform -%}
      </span>

    </span>
  </span>
</section>

{% schema %}
{
  "name": "t:sections.main-activate-account.name",
  "settings": []
}
{% endschema %}