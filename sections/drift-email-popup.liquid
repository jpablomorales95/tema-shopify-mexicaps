{% comment %}
  ============================================
  DRIFT Theme by WEBEXP, LLC
  Email Capture Popup — Time-delayed modal
  V3: Logo Image + Discount Code Reveal
  Shopify customer system integration
  https://webexp.dev
  ============================================
{% endcomment %}

{%- if section.settings.enable_popup -%}
  {%- liquid
    assign has_logo = false
    if section.settings.popup_logo != blank
      assign has_logo = true
    endif
    assign has_discount = false
    if section.settings.enable_discount and section.settings.discount_code != blank
      assign has_discount = true
    endif
  -%}

  <span
    class="drift-popup"
    data-email-popup
    data-popup-delay="{{ section.settings.popup_delay }}"
    data-popup-cookie-days="{{ section.settings.cookie_days }}"
    aria-hidden="true"
    role="dialog"
    aria-label="{{ section.settings.heading | escape }}"
  >
    {%- comment -%} Backdrop {%- endcomment -%}
    <span class="drift-popup__backdrop" data-popup-backdrop></span>

    {%- comment -%} Modal {%- endcomment -%}
    <span class="drift-popup__modal drift-glass" data-popup-modal>

      {%- comment -%} Close button {%- endcomment -%}
      <button
        class="drift-icon-btn drift-popup__close"
        data-popup-close
        aria-label="Close popup"
        type="button"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>

      {%- comment -%} Content — form state {%- endcomment -%}
      <span class="drift-popup__content" data-popup-form-state>

        {%- comment -%} Logo image (V3) {%- endcomment -%}
        {%- if has_logo -%}
          <span class="drift-popup__logo-wrap">
            <img
              class="drift-popup__logo"
              src="{{ section.settings.popup_logo | image_url: height: 120 }}"
              srcset="{{ section.settings.popup_logo | image_url: height: 60 }} 1x, {{ section.settings.popup_logo | image_url: height: 120 }} 2x"
              alt="{{ shop.name | escape }}"
              width="{{ section.settings.popup_logo.width }}"
              height="{{ section.settings.popup_logo.height }}"
              loading="lazy"
              draggable="false"
              style="max-height: {{ section.settings.popup_logo_height }}px;"
            >
          </span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <span class="drift-popup__heading">{{ section.settings.heading }}</span>
        {%- endif -%}

        {%- if section.settings.subtext != blank -%}
          <span class="drift-popup__subtext">{{ section.settings.subtext }}</span>
        {%- endif -%}

        {%- comment -%} Shopify customer form — native submit {%- endcomment -%}
        {%- form 'customer', id: 'drift-popup-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,popup">
          <span class="drift-popup__field">
            <input
              type="email"
              name="contact[email]"
              class="drift-popup__input"
              placeholder="Enter your email"
              required
              autocomplete="email"
              aria-label="Email address"
              data-popup-email
            >
            <button
              type="submit"
              class="drift-btn drift-btn--primary drift-popup__submit"
              data-popup-submit
            >
              {{ section.settings.button_text }}
            </button>
          </span>
        {%- endform -%}

      </span>

      {%- comment -%} Content — success state {%- endcomment -%}
      <span class="drift-popup__content drift-popup__success" data-popup-success-state hidden>

        <svg class="drift-popup__success-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>

        <span class="drift-popup__heading">{{ section.settings.success_heading }}</span>

        {%- if section.settings.success_message != blank -%}
          <span class="drift-popup__subtext">{{ section.settings.success_message }}</span>
        {%- endif -%}

        {%- comment -%} Discount code reveal (V3) {%- endcomment -%}
        {%- if has_discount -%}
          <span class="drift-popup__discount" data-popup-discount>
            {%- if section.settings.discount_label != blank -%}
              <span class="drift-popup__discount-label">{{ section.settings.discount_label }}</span>
            {%- endif -%}
            <button
              class="drift-popup__discount-code"
              data-popup-discount-code="{{ section.settings.discount_code }}"
              type="button"
              aria-label="Copy discount code"
            >
              <span class="drift-popup__discount-text" data-popup-discount-text>{{ section.settings.discount_code }}</span>
              <svg class="drift-popup__discount-copy" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
              </svg>
            </button>
            <span class="drift-popup__discount-copied" data-popup-discount-copied hidden>Copied!</span>
          </span>
        {%- endif -%}

      </span>

    </span>
  </span>
{%- endif -%}

{% schema %}
{
  "name": "Email Popup",
  "class": "drift-section-popup",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Popup Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_popup",
      "label": "Enable email capture popup",
      "default": false
    },
    {
      "type": "range",
      "id": "popup_delay",
      "label": "Delay before showing (seconds)",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 5,
      "unit": "s"
    },
    {
      "type": "range",
      "id": "cookie_days",
      "label": "Don't show again for (days)",
      "info": "After a visitor dismisses the popup, it won't reappear for this many days. Visitors who subscribe won't see the popup again for 1 year.",
      "min": 1,
      "max": 90,
      "step": 1,
      "default": 7,
      "unit": "d"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "popup_logo",
      "label": "Logo image",
      "info": "Optional logo or image displayed above the heading."
    },
    {
      "type": "range",
      "id": "popup_logo_height",
      "label": "Logo max height",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in the loop"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Sign up and be the first to know about new drops, restocks, and exclusive offers."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Subscribe"
    },
    {
      "type": "header",
      "content": "Success State"
    },
    {
      "type": "text",
      "id": "success_heading",
      "label": "Success heading",
      "default": "You're in"
    },
    {
      "type": "textarea",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing. Keep an eye on your inbox."
    },
    {
      "type": "header",
      "content": "Discount Code"
    },
    {
      "type": "checkbox",
      "id": "enable_discount",
      "label": "Show discount code after signup",
      "default": false,
      "info": "Reveals a discount code on the success screen after a visitor subscribes."
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount code",
      "info": "The exact code the customer will use at checkout."
    },
    {
      "type": "text",
      "id": "discount_label",
      "label": "Code label",
      "default": "Your exclusive code",
      "info": "Text shown above the code."
    }
  ],
  "presets": [
    {
      "name": "Email Popup"
    }
  ]
}
{% endschema %}