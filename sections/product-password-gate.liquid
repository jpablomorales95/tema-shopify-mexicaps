{%- liquid
  assign gate_password    = "MXCSXREBOLL"
  assign cookie_minutes   = 5
  assign gate_title       = section.settings.gate_title       | default: "Acceso Exclusivo"
  assign gate_subtitle    = section.settings.gate_subtitle    | default: "Este producto es de acceso limitado. Ingresa tu código para continuar."
  assign gate_placeholder = section.settings.gate_placeholder | default: "Ingresa tu código"
  assign gate_btn_text    = section.settings.gate_btn_text    | default: "DESBLOQUEAR"
  assign gate_error_msg   = section.settings.gate_error_msg   | default: "Código incorrecto. Inténtalo de nuevo."
  assign gate_icon        = section.settings.gate_icon        | default: "🔐"
  assign gate_badge       = section.settings.gate_badge       | default: "PREVENTA EXCLUSIVA"
  assign show_badge       = section.settings.show_badge
  assign show_logo        = section.settings.show_logo
  assign logo_image       = section.settings.logo_image
  assign accent_color     = section.settings.accent_color     | default: "#ffffff"
-%}

{%- assign cookie_key = "mxcs_gate_" | append: product.id -%}

<style>
  #mxcs-gate-overlay {
    position: fixed;
    inset: 0;
    z-index: 9990;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .mxcs-gate__card {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 460px;
    background: rgba(18, 18, 18, 0.85);
    backdrop-filter: blur(30px) saturate(160%);
    -webkit-backdrop-filter: blur(30px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 24px;
    padding: 44px 40px 40px;
    box-shadow: 0 32px 80px rgba(0,0,0,0.6), 0 1px 0 rgba(255,255,255,0.06) inset;
    text-align: center;
    animation: mxcs-in 0.45s cubic-bezier(0.34, 1.4, 0.64, 1) both;
  }

  @keyframes mxcs-in {
    from { opacity: 0; transform: translateY(20px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .mxcs-gate__badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
    color: rgba(255,255,255,0.75);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 100px;
    margin-bottom: 24px;
    font-family: var(--drift-font-body);
  }

  .mxcs-gate__badge::before {
    content: '';
    width: 6px;
    height: 6px;
    background: {{ accent_color }};
    border-radius: 50%;
    flex-shrink: 0;
    animation: mxcs-pulse 1.8s ease-in-out infinite;
  }

  @keyframes mxcs-pulse {
    0%,100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.35; transform: scale(0.6); }
  }

  .mxcs-gate__logo-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
  }

  .mxcs-gate__logo {
    width: 72px;
    height: auto;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  .mxcs-gate__icon {
    font-size: 48px;
    display: block;
    line-height: 1;
    margin-bottom: 4px;
  }

  .mxcs-gate__title {
    font-family: var(--drift-font-heading);
    font-size: 30px;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 12px;
    line-height: 1.15;
    letter-spacing: -0.5px;
  }

  .mxcs-gate__subtitle {
    font-family: var(--drift-font-body);
    font-size: 14px;
    color: rgba(255,255,255,0.50);
    margin: 0 0 28px;
    line-height: 1.65;
  }

  .mxcs-gate__input-wrap {
    position: relative;
    margin-bottom: 12px;
  }

  .mxcs-gate__input {
    width: 100%;
    box-sizing: border-box;
    background: rgba(255,255,255,0.07);
    border: 1.5px solid rgba(255,255,255,0.12);
    border-radius: 14px;
    padding: 15px 48px 15px 20px;
    font-size: 15px;
    font-family: var(--drift-font-body);
    color: #fff;
    letter-spacing: 3px;
    outline: none;
    text-align: center;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .mxcs-gate__input::placeholder {
    color: rgba(255,255,255,0.28);
    letter-spacing: 0.5px;
    font-size: 13px;
  }

  .mxcs-gate__input:focus {
    border-color: {{ accent_color }};
    box-shadow: 0 0 0 3px {{ accent_color }}22;
  }

  .mxcs-gate__input.mxcs-error {
    border-color: #ff5555;
    animation: mxcs-shake 0.38s ease;
  }

  @keyframes mxcs-shake {
    0%,100% { transform: translateX(0); }
    20%     { transform: translateX(-7px); }
    40%     { transform: translateX(7px); }
    60%     { transform: translateX(-5px); }
    80%     { transform: translateX(5px); }
  }

  .mxcs-gate__toggle-pw {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: rgba(255,255,255,0.35);
    font-size: 17px;
    line-height: 1;
    padding: 4px;
    transition: color 0.2s;
  }
  .mxcs-gate__toggle-pw:hover { color: rgba(255,255,255,0.8); }

  .mxcs-gate__error {
    visibility: hidden;
    font-size: 12px;
    color: #ff6b6b;
    font-family: var(--drift-font-body);
    font-weight: 500;
    height: 20px;
    line-height: 20px;
    margin-bottom: 10px;
    transition: opacity 0.2s;
    opacity: 0;
  }
  .mxcs-gate__error.mxcs-visible {
    visibility: visible;
    opacity: 1;
  }

  .mxcs-gate__btn {
    display: block;
    width: 100%;
    background: {{ accent_color }};
    color: #000;
    border: none;
    border-radius: 14px;
    padding: 17px 24px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-family: var(--drift-font-body);
    cursor: pointer;
    transition: opacity 0.2s, transform 0.18s, box-shadow 0.2s;
    margin-top: 4px;
  }

  .mxcs-gate__btn:hover {
    opacity: 0.85;
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(255,255,255,0.15);
  }
  .mxcs-gate__btn:active { transform: translateY(0); }
  .mxcs-gate__btn.mxcs-loading { pointer-events: none; opacity: 0.55; }

  .mxcs-gate__divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 24px 0 16px;
    color: rgba(255,255,255,0.18);
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-family: var(--drift-font-body);
  }
  .mxcs-gate__divider::before,
  .mxcs-gate__divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(255,255,255,0.08);
  }

  .mxcs-gate__footer {
    font-size: 12px;
    color: rgba(255,255,255,0.28);
    font-family: var(--drift-font-body);
  }
  .mxcs-gate__footer a {
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    border-bottom: 1px solid rgba(255,255,255,0.18);
    transition: color 0.2s;
  }
  .mxcs-gate__footer a:hover { color: #fff; }

  #mxcs-gate-overlay.mxcs-unlocked {
    animation: mxcs-out 0.4s ease forwards;
  }
  @keyframes mxcs-out {
    to { opacity: 0; pointer-events: none; }
  }

  @media (max-width: 600px) {
    .mxcs-gate__card { padding: 36px 22px 32px; border-radius: 20px; }
    .mxcs-gate__title { font-size: 24px; }
  }
</style>

<div id="mxcs-gate-overlay" role="dialog" aria-modal="true">
  <div class="mxcs-gate__card">

    {%- if show_badge -%}
      <div class="mxcs-gate__badge">{{ gate_badge }}</div>
    {%- endif -%}

    <div class="mxcs-gate__logo-wrap">
      {%- if show_logo and logo_image != blank -%}
        <img class="mxcs-gate__logo" src="{{ logo_image | image_url: width: 200 }}" alt="{{ shop.name }}" width="72" loading="eager">
      {%- else -%}
        <span class="mxcs-gate__icon">{{ gate_icon }}</span>
      {%- endif -%}
    </div>

    <h2 class="mxcs-gate__title">{{ gate_title }}</h2>
    <p class="mxcs-gate__subtitle">{{ gate_subtitle }}</p>

    <div class="mxcs-gate__input-wrap">
      <input
        id="mxcs-gate-input"
        class="mxcs-gate__input"
        type="password"
        placeholder="{{ gate_placeholder }}"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="none"
        spellcheck="false"
        maxlength="32"
      >
      <button class="mxcs-gate__toggle-pw" type="button" onclick="mxcsTogglePw(this)" aria-label="Mostrar código">👁</button>
    </div>

    <p id="mxcs-gate-error" class="mxcs-gate__error">{{ gate_error_msg }}</p>

    <button id="mxcs-gate-btn" class="mxcs-gate__btn" type="button" onclick="mxcsGateSubmit()">
      {{ gate_btn_text }}
    </button>

    <div class="mxcs-gate__divider">Mexicaps</div>

    <p class="mxcs-gate__footer">
      ¿Necesitas acceso? <a href="https://wa.me/573176306014" target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
    </p>

  </div>
</div>

<script>
(function(){
  var PW         = {{ gate_password | json }};
  var COOKIE_KEY = {{ cookie_key | json }};
  var MINUTES    = {{ cookie_minutes }};
  var BTN_TEXT   = {{ gate_btn_text | json }};

  var overlay = document.getElementById('mxcs-gate-overlay');
  var input   = document.getElementById('mxcs-gate-input');
  var error   = document.getElementById('mxcs-gate-error');
  var btn     = document.getElementById('mxcs-gate-btn');

  function setCookie(k,v,m){ var e=new Date(); e.setTime(e.getTime()+m*60000); document.cookie=k+'='+encodeURIComponent(v)+';expires='+e.toUTCString()+';path=/;SameSite=Strict'; }
  function getCookie(k){ var m=document.cookie.match(new RegExp('(?:^|;\\s*)'+k.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'=([^;]*)')); return m?decodeURIComponent(m[1]):null; }

  function unlock(){
    document.body.style.overflow='';
    overlay.classList.add('mxcs-unlocked');
    overlay.addEventListener('animationend',function(){ overlay.remove(); },{once:true});
  }

  if(getCookie(COOKIE_KEY)==='granted'){ unlock(); return; }

  document.body.style.overflow='hidden';
  input.addEventListener('keydown',function(e){ if(e.key==='Enter') mxcsGateSubmit(); });
  setTimeout(function(){ input.focus(); },350);

  window.mxcsGateSubmit=function(){
    var val=input.value.trim();
    if(!val){ showErr(); return; }
    btn.classList.add('mxcs-loading');
    btn.textContent='···';
    setTimeout(function(){
      if(val===PW){
        setCookie(COOKIE_KEY,'granted',MINUTES);
        unlock();
      } else {
        btn.classList.remove('mxcs-loading');
        btn.textContent=BTN_TEXT;
        showErr();
      }
    },550);
  };

  function showErr(){
    input.classList.add('mxcs-error');
    error.classList.add('mxcs-visible');
    input.focus(); input.select();
    setTimeout(function(){ input.classList.remove('mxcs-error'); },420);
  }

  window.mxcsTogglePw=function(b){
    var isPw=input.type==='password';
    input.type=isPw?'text':'password';
    b.textContent=isPw?'🙈':'👁';
  };
})();
</script>

{% schema %}
{
  "name": "🔐 Product Gate",
  "tag": "div",
  "class": "mxcs-gate-section",
  "settings": [
    { "type": "header", "content": "Textos" },
    { "type": "text",     "id": "gate_title",       "label": "Título",              "default": "Acceso Exclusivo" },
    { "type": "textarea", "id": "gate_subtitle",    "label": "Subtítulo",           "default": "Este producto es de acceso limitado. Ingresa tu código para continuar." },
    { "type": "text",     "id": "gate_placeholder", "label": "Placeholder input",   "default": "Ingresa tu código" },
    { "type": "text",     "id": "gate_btn_text",    "label": "Texto del botón",     "default": "DESBLOQUEAR" },
    { "type": "text",     "id": "gate_error_msg",   "label": "Mensaje de error",    "default": "Código incorrecto. Inténtalo de nuevo." },
    { "type": "text",     "id": "gate_icon",        "label": "Ícono emoji",         "default": "🔐" },
    { "type": "header", "content": "Badge" },
    { "type": "checkbox", "id": "show_badge",  "label": "Mostrar badge", "default": true },
    { "type": "text",     "id": "gate_badge",  "label": "Texto del badge", "default": "PREVENTA EXCLUSIVA" },
    { "type": "header", "content": "Logo" },
    { "type": "checkbox",    "id": "show_logo",   "label": "Usar logo en lugar del ícono", "default": false },
    { "type": "image_picker","id": "logo_image",  "label": "Logo (PNG transparente recomendado)" },
    { "type": "header", "content": "Apariencia" },
    { "type": "color", "id": "accent_color", "label": "Color de acento", "default": "#ffffff" }
  ],
  "presets": [{ "name": "🔐 Product Gate" }]
}
{% endschema %}